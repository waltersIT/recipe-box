# Copy to `.env` and fill in what you need. Everything here is optional for
# local development. deploy.sh writes this file for you on a server.

# Enables Claude for PDFs, screenshots, and pages without recipe markup.
# Without it, on-device OCR + a rule-based parser are used instead.
# ANTHROPIC_API_KEY=sk-ant-...

# auto (use Claude when a key is set) | on | off
# RECIPE_LLM=auto
# RECIPE_LLM_MODEL=claude-opus-5
# RECIPE_LLM_EFFORT=low

# DJANGO_SECRET_KEY=change-me
# DJANGO_DEBUG=true
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://recipes.example.com

# --- Database -------------------------------------------------------------------
# Leave DB_HOST unset to use SQLite (backend/db.sqlite3). Set it to use
# PostgreSQL, e.g. Amazon RDS with IAM auth (the instance role needs
# rds-db:connect on DB_USER, and the user needs `GRANT rds_iam TO <user>`).
# DB_HOST=database-1.cluster-xxxx.us-east-1.rds.amazonaws.com
# DB_PORT=5432
# DB_NAME=recipebox
# DB_USER=postgres
# DB_IAM_AUTH=True
# DB_PASSWORD=
# DB_SSLMODE=require

# --- Serving behind nginx (set by deploy.sh) ----------------------------------------
# DJANGO_MEDIA_ROOT=/var/lib/recipe-box/media
# DJANGO_STATIC_ROOT=
# USE_X_FORWARDED_PROTO=False
# DJANGO_SECURE_SSL=False
